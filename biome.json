{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"files": {
		"includes": [
			"**",
			"!!**/node_modules",
			"!!**/build",
			"!!**/public/build",
			"!!**/coverage",
			"!!**/.pnpm-store",
			"!!**/.cache",
			"!!**/test/saml-idp",
			"!!**/coverage",
			"!!**/data.ms",
			"!!**/postgres-data"
		]
	},
	"formatter": {
		"enabled": true
	},
	"assist": {
		"enabled": false
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none"
		}
	}
}
